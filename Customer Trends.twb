      <aliases enabled='yes' />
      <column caption='Total Revenue' datatype='integer' name='[Calculation_1987123122741248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([purchase_amount])' />
      </column>
      <column caption='Total Customers' datatype='integer' name='[Calculation_1987123122790401]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([customer_id])' />
      </column>
      <column caption='Avg Order Value' datatype='real' name='[Calculation_1987123122835458]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1987123122741248] / [Calculation_1987123122790401]' />
      </column>
      <column caption='Subscription Rate' datatype='real' default-format='p0.00%' name='[Calculation_1987123122913283]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [subscription_status] = &quot;Yes&quot; THEN 1 ELSE 0 END) / [Calculation_1987123122790401]' />
      </column>
      <column caption='Pct Loyal' datatype='real' default-format='p0.00%' name='[Calculation_1987123123015684]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [customer_segment] = &quot;Loyal&quot; THEN 1 ELSE 0 END) / [Calculation_1987123122790401]' />
      </column>
      <column caption='Channel Proxy' datatype='string' name='[Calculation_1987123123122181]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [shipping_type] = &quot;Store Pickup&quot; THEN &quot;In-Store Pickup&quot; ELSE&#13;&#10;&quot;Shipped&quot; END' />
      </column>
